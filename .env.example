# AetherTerm. Copy to .env. Real values live in the gitignored .env.
# Gemini is optional. Local chat uses Ollama.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Leave blank unless this key actually has a Veo model. The current Studio key does not.
GEMINI_VIDEO_MODEL=
GOOGLE_API_KEY=
AI_STUDIO_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# OLLAMA_URL is what the server uses. OLLAMA_HOST is the house name for the same address.
# The main Ollama (127.0.0.1:11434). v0.3.1 pointed at a 1660 Ti instance on :11435, which is retired (the card crashed under load).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Default model for local chat and `local-ask` until you pick one in Settings.
OLLAMA_MODEL=devmilla:latest
OLLAMA_FAST_MODEL=devmilla:latest

APP_URL=http://127.0.0.1:3333
PORT=3333
AETHERTERM_SYNC_ROOT=/home/milla/aetherterm-files
